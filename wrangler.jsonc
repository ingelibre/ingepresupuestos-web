{
  // Configuración de despliegue para Cloudflare Workers (sitio estático).
  // El build de Git ejecuta `npx wrangler deploy`, que necesita este archivo
  // para saber que debe publicar los assets de la raíz del repo.
  "name": "ingepresupuestos-web",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./"
  }
}
